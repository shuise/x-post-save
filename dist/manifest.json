{
  "manifest_version": 3,
  "name": "小蜜蜂",
  "version": "1.0.0",
  "description": "一键批量下载 X 点赞推文及其图片、视频等媒体资源",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "小蜜蜂",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "contextMenus"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://note-card-mauve.vercel.app/*",
    "https://pinyin-annotator.tjsky.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["isolated.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://note-card-mauve.vercel.app/*",
        "https://pinyin-annotator.tjsky.net/*"
      ],
      "js": ["inject-text.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}